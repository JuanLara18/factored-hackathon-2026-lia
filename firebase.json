{
  "hosting": {
    "public": "tecnologia/web/sitio",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' http://localhost:8765 https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"},
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
          {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"},
          {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"}
        ]
      },
      {
        "source": "assets/**",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]
      },
      {
        "source": "**/*.html",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
